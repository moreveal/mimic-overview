---
import { Copy } from "lucide-astro";
import { codeToHtml } from "shiki";
interface Props {
  title?: string;
  code: string;
  label?: string;
  lang?: string;
}
const {
  title = "Terminal",
  code,
  label = "Copy code",
  lang = "javascript",
} = Astro.props;
const highlighted = await codeToHtml(code, {
  lang,
  theme: "github-dark-default",
});
---

<div class="code-window panel">
  <div class="code-titlebar">
    <span>{title}</span><button
      type="button"
      aria-label={label}
      data-copy={code}
      ><Copy size={17} strokeWidth={1.8} /><span class="copy-label">Copy</span
      ></button
    >
  </div>
  <div class="highlighted" set:html={highlighted} />
</div>
<script>
  document
    .querySelectorAll<HTMLButtonElement>("[data-copy]")
    .forEach((button) => {
      button.addEventListener("click", async () => {
        await navigator.clipboard.writeText(button.dataset.copy || "");
        const label = button.querySelector<HTMLElement>(".copy-label");
        if (label) {
          label.textContent = "Copied";
          setTimeout(() => (label.textContent = "Copy"), 1500);
        }
      });
    });
</script>
<style>
  .code-window {
    overflow: hidden;
  }
  .code-titlebar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 44px;
    padding: 0 16px;
    border-bottom: 1px solid var(--line);
    color: #aeb7c3;
    font-size: 0.78rem;
    font-family: var(--mono);
  }
  button {
    justify-self: end;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px;
    border: 0;
    border-radius: 5px;
    background: transparent;
    color: #c9d1db;
    cursor: pointer;
  }
  button:hover {
    background: #263137;
    color: #fff;
  }
  .copy-label {
    font-size: 0.75rem;
  }
  .highlighted :global(pre) {
    margin: 0;
    padding: 22px;
    overflow: auto;
    border: 0;
    border-radius: 0;
    background: transparent !important;
    font-size: clamp(0.78rem, 1.15vw, 0.94rem);
    line-height: 1.6;
    tab-size: 2;
  }
  .highlighted :global(code) {
    display: block;
    width: 100%;
    font-family: var(--mono);
    counter-reset: code-line;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }
  .highlighted :global(.line) {
    display: inline;
    counter-increment: code-line;
  }
  .highlighted :global(.line::before) {
    display: inline-block;
    width: 2.1em;
    margin-right: 1em;
    color: #778793;
    content: counter(code-line);
    text-align: right;
    user-select: none;
  }
  @media (max-width: 520px) {
    .copy-label {
      position: absolute;
      clip: rect(0 0 0 0);
    }
    .highlighted :global(pre) {
      padding: 16px;
    }
  }
</style>
