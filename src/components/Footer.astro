---
const base = import.meta.env.BASE_URL;
const year = new Date().getFullYear();
---

<footer>
  <div class="container footer-top">
    <div class="footer-brand">
      <a href={base}>mimic</a><p>
        Run the web without the weight of a full browser.
      </p>
    </div>
    <nav aria-label="Footer navigation">
      <div>
        <strong>Explore</strong><a href={base}>Product</a><a
          href={`${base}docs/`}>Documentation</a
        ><a href={`${base}#benchmarks`}>Benchmarks</a><a
          href={`${base}changelog/`}>Changelog</a>
      </div>
      <div>
        <strong>Project</strong><a href="https://github.com/moreveal/mimic"
          >GitHub</a
        ><a href="https://github.com/moreveal/mimic/releases/latest"
          >Downloads</a
        ><a href="https://github.com/moreveal/mimic/issues">Issues</a><a
          href="https://github.com/moreveal/mimic/blob/main/LICENSE">License</a>
      </div>
      <div>
        <strong>More</strong><a href={`${base}privacy/`}>Privacy</a><a
          href="https://github.com/moreveal/mimic/tree/main/examples"
          >Examples</a
        ><a href="https://discord.com/users/moreveal">Contact on Discord</a>
      </div>
    </nav>
  </div>
  <div class="container footer-bottom">
    <span>© {year} Mimic</span><span>Public beta · Windows & Linux</span>
  </div>
</footer>
<style>
  footer {
    border-top: 1px solid var(--line);
    background: #101618;
  }
  .footer-top {
    display: flex;
    justify-content: space-between;
    gap: 70px;
    padding-top: 62px;
    padding-bottom: 70px;
  }
  .footer-brand {
    max-width: 360px;
  }
  .footer-brand a {
    color: var(--text);
    font-size: 1.65rem;
    font-weight: 750;
    letter-spacing: -0.06em;
  }
  .footer-brand p {
    margin: 14px 0 0;
    color: var(--muted);
  }
  nav {
    display: grid;
    grid-template-columns: repeat(3, minmax(120px, 1fr));
    gap: 55px;
  }
  nav strong {
    display: block;
    margin-bottom: 15px;
    color: var(--text);
    font-size: 0.83rem;
    font-weight: 650;
  }
  nav a {
    display: block;
    padding: 4px 0;
    color: var(--muted);
    font-size: 0.84rem;
  }
  nav a:hover {
    color: var(--blue-bright);
  }
  .footer-bottom {
    display: flex;
    justify-content: space-between;
    gap: 15px;
    padding-top: 21px;
    padding-bottom: 25px;
    border-top: 1px solid var(--line);
    color: var(--quiet);
    font-size: 0.8rem;
  }
  @media (max-width: 760px) {
    .footer-top {
      display: block;
      padding-top: 45px;
      padding-bottom: 45px;
    }
    nav {
      gap: 18px;
      margin-top: 34px;
    }
    .footer-bottom {
      flex-wrap: wrap;
    }
  }
  @media (max-width: 480px) {
    nav {
      grid-template-columns: repeat(2, 1fr);
      row-gap: 30px;
    }
  }
</style>
