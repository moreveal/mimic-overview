---
import Logo from "./Logo.astro";
import { Download } from "lucide-astro";
const base = import.meta.env.BASE_URL;
const path = Astro.url.pathname;
const links = [
  { label: "Product", href: base },
  { label: "Documentation", href: `${base}docs/` },
  { label: "Benchmarks", href: `${base}#benchmarks` },
  { label: "Changelog", href: `${base}changelog/` },
  {
    label: "GitHub",
    href: "https://github.com/moreveal/mimic",
    external: true,
  },
];
---

<header class="site-header">
  <div class="container nav-wrap">
    <a class="brand" href={base} aria-label="Mimic home"><Logo /></a>
    <button
      class="menu-button"
      type="button"
      aria-label="Open navigation"
      aria-expanded="false"
      aria-controls="site-nav"
    >
      <span></span><span></span>
    </button>
    <nav id="site-nav" aria-label="Primary navigation">
      {
        links.map((link) => (
          <a
            href={link.href}
            aria-current={
              !link.external && path === link.href ? "page" : undefined
            }
          >
            {link.label}
          </a>
        ))
      }
      <a
        class="download"
        href="https://github.com/moreveal/mimic/releases/latest"
      >
        <Download size={19} strokeWidth={2} />
        Download
      </a>
    </nav>
  </div>
</header>
<script>
  const button = document.querySelector<HTMLButtonElement>(".menu-button");
  const nav = document.querySelector<HTMLElement>("#site-nav");
  button?.addEventListener("click", () => {
    const open = button.getAttribute("aria-expanded") === "true";
    button.setAttribute("aria-expanded", String(!open));
    button.setAttribute(
      "aria-label",
      open ? "Open navigation" : "Close navigation",
    );
    nav?.toggleAttribute("data-open", !open);
  });
</script>
<style>
  .site-header {
    height: 66px;
    display: flex;
    align-items: center;
    border-bottom: 1px solid var(--line);
  }
  .nav-wrap {
    display: flex;
    align-items: center;
  }
  .brand {
    display: inline-flex;
  }
  nav {
    display: flex;
    align-items: center;
    flex: 1;
    gap: 27px;
    margin-left: 54px;
    color: #c2cbd3;
    font-size: 0.88rem;
  }
  nav > a:not(.download):hover,
  nav > a[aria-current="page"] {
    color: #fff;
  }
  .download {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    min-height: 40px;
    padding: 0 16px;
    border-radius: 7px;
    margin-left: auto;
    background: #6db6ff;
    color: #081521;
    font-weight: 670;
  }
  .menu-button {
    display: none;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 1px solid var(--line);
    border-radius: 7px;
    background: var(--surface);
  }
  .menu-button span {
    display: block;
    width: 19px;
    height: 1px;
    margin: 5px auto;
    background: #fff;
  }
  @media (max-width: 760px) {
    .site-header {
      height: 54px;
    }
    .nav-wrap {
      justify-content: space-between;
    }
    .menu-button {
      display: block;
    }
    nav {
      display: none;
      position: absolute;
      z-index: 20;
      top: 54px;
      left: 12px;
      right: 12px;
      align-items: stretch;
      flex-direction: column;
      gap: 0;
      padding: 8px;
      border: 1px solid var(--line);
      border-radius: 10px;
      margin: 0;
      background: var(--surface);
      box-shadow: 0 20px 60px #0008;
    }
    nav[data-open] {
      display: flex;
    }
    nav a {
      padding: 13px;
    }
    .download {
      margin-top: 6px;
      margin-left: 0;
      justify-content: center;
    }
  }
</style>
