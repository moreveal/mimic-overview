---
interface Props {
  compact?: boolean;
}
const { compact = false } = Astro.props;
---

<span class="logo" aria-label="Mimic">
  {!compact && <span>mimic</span>}
</span>
<style>
  .logo {
    display: inline-flex;
    align-items: center;
    color: var(--text);
    font-family: var(--display);
    font-size: 1.68rem;
    font-weight: 770;
    letter-spacing: -0.075em;
    line-height: 1;
  }
</style>
