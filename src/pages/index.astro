    line-height: 1.4;
  }
  .metric-note {
    grid-column: 1/-1;
    margin: -6px 0 0;
    text-align: center;
    color: var(--quiet);
    font-size: 0.76rem;
  }
  .metric-note a {
    display: inline-flex;
    align-items: center;
    gap: 3px;
    color: var(--blue-bright);
  }
  .details {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 38px;
    padding-bottom: 66px;
  }
  .detail-column + .detail-column {
    padding-left: 35px;
    border-left: 1px solid #26353b;
  }
  .kicker {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: #b0d3f5;
    font-size: 0.8rem;
  }
  .kicker:before {
    content: "";
    width: 16px;
    height: 2px;
    background: var(--blue);
  }
  .details h2,
  .closing h2 {
    margin: 10px 0 11px;
    font-family: var(--display);
    font-size: clamp(1.55rem, 2.2vw, 2.1rem);
    font-weight: 730;
    line-height: 1.25;
    letter-spacing: -0.04em;
  }
  .details p,
  .closing p {
    max-width: 480px;
    margin: 0;
    color: var(--muted);
    font-size: 0.91rem;
    line-height: 1.62;
  }
  .detail-list {
    display: grid;
    gap: 17px;
    margin-top: 25px;
  }
  .detail-list > div {
    display: flex;
    gap: 15px;
  }
  .detail-list > div > span {
    flex: none;
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border: 1px solid var(--blue);
    border-radius: 50%;
    color: var(--text);
  }
  .detail-list strong,
  .boundary-panel strong {
    font-size: 0.85rem;
    font-weight: 650;
  }
  .detail-list p,
  .boundary-panel p {
    margin: 3px 0 0;
    color: var(--muted);
    font-size: 0.76rem;
    line-height: 1.45;
  }
  .boundary-panel {
    margin-top: 20px;
    padding: 5px 19px;
    border: 1px solid var(--line);
    border-radius: 9px;
    background: #1b2529;
  }
  .boundary-panel > div {
    display: flex;
    align-items: start;
    gap: 17px;
    padding: 12px 0;
    border-bottom: 1px solid #334147;
  }
  .boundary-panel > div > svg {
