      grid-template-columns: 1fr;
      gap: 30px;
    }
    .hero-snippets {
      max-width: 700px;
    }
    .hero-copy > p {
      max-width: 680px;
    }
    .details {
      gap: 25px;
    }
  }
  @media (max-width: 760px) {
    .hero {
      padding-top: 19px;
      padding-bottom: 38px;
      gap: 28px;
    }
    h1 {
      margin: 13px 0 10px;
      font-size: clamp(2rem, 8.6vw, 2.7rem);
      line-height: 1.13;
    }
    .hero-copy > p {
      font-size: 0.94rem;
    }
    .hero-actions {
      flex-direction: column;
      gap: 8px;
      margin-top: 19px;
    }
    .hero-actions .button {
      width: 100%;
    }
    .hero-foot {
      margin-top: 13px;
    }
    .hero-snippets {
      grid-template-columns: 1fr;
