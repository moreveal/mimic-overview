    overflow: auto;
    padding: 10px 13px;
    font-size: 0.71rem;
    line-height: 1.73;
  }
  .run-heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 39px;
    gap: 4px;
    padding: 0 12px;
    border-bottom: 1px solid var(--line);
    font-size: 0.78rem;
  }
