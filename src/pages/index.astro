    gap: 18px;
    padding-bottom: 62px;
  }
  .metric {
    display: flex;
    align-items: start;
    gap: 17px;
    min-width: 0;
    min-height: 132px;
    padding: 20px;
    border: 1px solid var(--line);
    border-radius: 9px;
    background: linear-gradient(140deg, #1b2428, #171e21);
  }
  .metric-icon {
    flex: none;
    display: grid;
    place-items: center;
    width: 51px;
    height: 51px;
    border-radius: 50%;
    background: #213345;
    color: var(--blue);
  }
  .metric strong,
  .metric span:not(.metric-icon),
  .metric small {
    display: block;
  }
  .metric strong {
    font-family: var(--display);
    font-size: 2.2rem;
    font-weight: 760;
    line-height: 1;
    letter-spacing: -0.055em;
  }
  .metric span:not(.metric-icon) {
