    flex-wrap: wrap;
    gap: 12px;
    margin-top: 29px;
  }
  .hero-foot {
    display: flex;
    align-items: center;
    gap: 11px;
    margin-top: 27px;
    color: var(--quiet);
    font-size: 0.78rem;
  }
  .hero-foot a {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: #b6c0ca;
    white-space: nowrap;
  }
  .hero-foot a:hover {
    color: var(--blue-bright);
  }
  .hero-foot > span {
    width: 1px;
    height: 15px;
    background: var(--line-bright);
  }
  .hero-foot p {
    margin: 0;
    white-space: nowrap;
  }
  .hero-snippets {
    display: grid;
    grid-template-columns: 1.15fr 0.92fr;
    gap: 10px;
