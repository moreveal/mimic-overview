    height: 28px;
    border: 0;
    padding-inline: 13px;
  }
  .run-snippet :global(.highlighted pre) {
    overflow: auto;
    padding: 8px 13px;
    font-size: 0.69rem;
    line-height: 1.65;
  }
  .run-bottom {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 15px 13px 0;
    border-top: 1px solid var(--line);
    color: var(--quiet);
    font-size: 0.72rem;
  }
  .run-bottom a {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    color: var(--blue-bright);
  }
  [hidden] {
    display: none !important;
  }
  .steps {
    padding-bottom: 35px;
  }
  .section-label {
    display: flex;
    align-items: center;
    gap: 20px;
  }
  .section-label h2 {
    margin: 0;
    font-size: 0.95rem;
    font-weight: 600;
  }
  .section-label span {
    flex: 1;
    border-top: 1px solid var(--line);
  }
  .steps ol {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 23px;
    margin: 0;
    padding: 18px 0 0;
