      height: 230px;
    }
    .connect-snippet :global(.highlighted pre) {
      height: 165px;
    }
    .run-snippet {
      height: auto;
    }
    .run-caption {
      padding: 12px;
    }
    .run-bottom {
      padding: 10px 13px 13px;
    }
    .steps ol {
      grid-template-columns: 1fr;
      gap: 20px;
    }
    .step-arrow {
      display: none;
    }
    .metrics {
      grid-template-columns: 1fr;
      gap: 9px;
      padding-bottom: 42px;
    }
    .metric {
      min-height: 0;
      padding: 14px;
    }
    .metric-note {
      margin-top: 7px;
    }
    .details {
      grid-template-columns: 1fr;
      gap: 41px;
      padding-bottom: 55px;
    }
    .detail-column + .detail-column {
      padding: 0;
      border: 0;
    }
    .closing {
      align-items: start;
      flex-direction: column;
    }
    .closing .button {
      width: 100%;
    }
  }
  @media (max-width: 390px) {
    .hero-foot {
      flex-wrap: wrap;
    }
    .hero-foot > span {
      display: none;
    }
    .status {
      font-size: 0.69rem;
    }
  }
</style>
