    color: var(--blue-bright);
    font-size: 0.68rem;
    white-space: nowrap;
  }
  .run-indicator i {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--blue-bright);
  }
  .run-caption {
    padding: 15px 13px 10px;
