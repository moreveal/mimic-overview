import BaseLayout from "@/layouts/BaseLayout.astro";
---
<BaseLayout title="Privacy — Mimic" description="How the Mimic website uses privacy-focused traffic analytics.">
  <section class="legal container prose"><span class="eyebrow">Legal</span><h1>Privacy.</h1><p class="lead">This website uses Cloudflare Web Analytics to understand aggregate traffic and improve the documentation.</p><h2>What is collected</h2><p>Cloudflare Web Analytics provides aggregated measurements such as page views, referring sites, browser type, and approximate country. The site does not use analytics cookies, user accounts, advertising trackers, or cross-site tracking.</p><h2>What we do not collect</h2><p>This website does not ask for names, email addresses, credentials, automation data, or Mimic profile files. Never include secrets, cookies, tokens, or private customer data in a public GitHub issue.</p><h2>External services</h2><p>Download, source, issue, and example links lead to GitHub. The footer also identifies Discord as an optional support channel. Those services apply their own privacy terms when you visit them.</p><h2>Contact</h2><p>For questions, open an issue in the <a href="https://github.com/moreveal/mimic/issues">public source-available repository</a> or contact <strong>moreveal</strong> on Discord.</p></section>
</BaseLayout>
<style>.legal { max-width: 820px; padding-top: 70px; padding-bottom: 110px; }.legal h1 { margin: 12px 0; font-size: clamp(3rem,7vw,5rem); letter-spacing: -.055em; }.legal .lead { font-size: 1.2rem; }</style>
